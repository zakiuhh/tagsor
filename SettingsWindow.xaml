<Window x:Class="Tagsor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootBorder"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.96" To="1.0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.96" To="1.0" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <!-- Theme Brushes (Default Dark, dynamically swapped for Light) -->
        <SolidColorBrush x:Key="CardBgBrush" Color="#1F1F24"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#35353E"/>
        <SolidColorBrush x:Key="SectionBgBrush" Color="#27272E"/>
        <SolidColorBrush x:Key="SectionBorderBrush" Color="#363640"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#32323B"/>
        <SolidColorBrush x:Key="TabBarBgBrush" Color="#18181C"/>
        <SolidColorBrush x:Key="ActiveTabBgBrush" Color="#2F2F38"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4F4F6"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="#71717A"/>
        <SolidColorBrush x:Key="BtnBgBrush" Color="#32323B"/>
        <SolidColorBrush x:Key="BtnHoverBgBrush" Color="#3E3E49"/>
        <SolidColorBrush x:Key="BtnBorderBrush" Color="#444450"/>
        <SolidColorBrush x:Key="CloseHoverBgBrush" Color="#32323B"/>
        <SolidColorBrush x:Key="CloseIconBrush" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="DangerTextBrush" Color="#FB7185"/>
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#3F2227"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#60A5FA"/>

        <!-- Close Button -->
        <Style x:Key="RoundedCloseButton" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ClosePill" Background="Transparent" CornerRadius="9">
                            <Viewbox Width="13" Height="13">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="XPath"
                                          Data="M 6,6 L 18,18 M 18,6 L 6,18"
                                          Stroke="{DynamicResource CloseIconBrush}"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ClosePill" Property="Background" Value="{DynamicResource CloseHoverBgBrush}"/>
                                <Setter TargetName="XPath" Property="Stroke" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Segmented Tab RadioButton -->
        <Style x:Key="SegmentedTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabPill"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabPill" Property="Background" Value="{DynamicResource ActiveTabBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Subtle Action Button -->
        <Style x:Key="SubtleButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BtnBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BtnHoverBgBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Danger Mini Button -->
        <Style x:Key="DangerMiniButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="Transparent"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Save Button -->
        <Style x:Key="AccentPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#60A5FA"/>
            <Setter Property="Foreground" Value="#0F1117"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern iOS/Win11 Pill Toggle Switch -->
        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="44"
                                Height="24"
                                CornerRadius="12"
                                Background="{DynamicResource BtnBgBrush}"
                                BorderBrush="{DynamicResource BtnBorderBrush}"
                                BorderThickness="1">
                            <Ellipse x:Name="Thumb"
                                     Width="18"
                                     Height="18"
                                     Fill="#E4E4E7"
                                     HorizontalAlignment="Left"
                                     Margin="2,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbSlide" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#60A5FA"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#0F1117"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbSlide"
                                                             Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbSlide"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Sleek Slider -->
        <Style x:Key="SleekSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="5"
                                    CornerRadius="2.5"
                                    Background="{DynamicResource BtnBgBrush}"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="2.5" Background="#60A5FA"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Width="16"
                                                        Height="16"
                                                        CornerRadius="8"
                                                        Background="#F4F4F6"
                                                        BorderBrush="#60A5FA"
                                                        BorderThickness="2.5"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interactive Hotkey Pill Box -->
        <Style x:Key="HotkeyBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BtnBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="144"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter TargetName="BoxBorder" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="BoxBorder" Property="Background" Value="#243247"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Border x:Name="RootBorder"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="26,22,26,24"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadow" BlurRadius="28" ShadowDepth="8" Opacity="0.55" Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <!-- Header (Draggable) -->
                <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,18">
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Tagsor Settings"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="17"
                                       FontWeight="SemiBold"/>
                            <Border Background="{DynamicResource BtnBgBrush}"
                                    CornerRadius="6"
                                    Padding="7,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="v1.3.0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Customize your mouse profiles, overlay timing, and global shortcuts"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Style="{StaticResource RoundedCloseButton}"
                            Click="CancelButton_Click"/>
                </Grid>

                <!-- Segmented Tab Bar -->
                <Border Background="{DynamicResource TabBarBgBrush}"
                        BorderBrush="{DynamicResource SectionBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="4"
                        Margin="0,0,0,22">
                    <UniformGrid Columns="3">
                        <RadioButton x:Name="TabProfilesBtn"
                                     Content="🖱  Mice &amp; Profiles"
                                     IsChecked="True"
                                     Style="{StaticResource SegmentedTabStyle}"
                                     Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabBehaviorBtn"
                                     Content="⏱  Timing &amp; Startup"
                                     Style="{StaticResource SegmentedTabStyle}"
                                     Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabShortcutsBtn"
                                     Content="⌨️  Shortcuts"
                                     Style="{StaticResource SegmentedTabStyle}"
                                     Checked="Tab_Checked"/>
                    </UniformGrid>
                </Border>

                <!-- Animated Tab Content Container -->
                <Grid x:Name="TabContentContainer" MinHeight="270" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="TabSlideTransform" Y="0"/>
                    </Grid.RenderTransform>

                    <!-- TAB 1: MICE & PROFILES -->
                    <StackPanel x:Name="ProfilesTabView" Visibility="Visible">
                        <Grid Margin="2,0,2,10">
                            <TextBlock Text="Connected &amp; Saved Devices"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="MouseCountLabel"
                                       Text="0 saved"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Border Background="{DynamicResource SectionBgBrush}"
                                BorderBrush="{DynamicResource SectionBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="230">
                                <StackPanel>
                                    <StackPanel x:Name="MiceListPanel"/>
                                    <StackPanel x:Name="EmptyMiceState" Margin="0,24,0,24" Visibility="Collapsed">
                                        <TextBlock Text="No saved mice yet"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Move or click with any mouse to automatically detect and name it."
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="12"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <!-- TAB 2: TIMING & BEHAVIOR -->
                    <StackPanel x:Name="BehaviorTabView" Visibility="Collapsed">
                        <Border Background="{DynamicResource SectionBgBrush}"
                                BorderBrush="{DynamicResource SectionBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="18,16">
                            <StackPanel>
                                <!-- Idle Fade Delay -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Idle fade-out delay"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="How long after stopping movement before the cursor tag gently fades out"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="12"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Background="{DynamicResource BtnBgBrush}"
                                            CornerRadius="7"
                                            Padding="10,4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                        <TextBlock x:Name="IdleDelayLabel"
                                                   Text="2.5s"
                                                   Foreground="#60A5FA"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"/>
                                    </Border>
                                    <Slider x:Name="IdleDelaySlider"
                                            Grid.Row="1"
                                            Minimum="0.5"
                                            Maximum="15.0"
                                            TickFrequency="0.5"
                                            IsSnapToTickEnabled="True"
                                            Style="{StaticResource SleekSliderStyle}"
                                            Margin="0,10,0,0"
                                            ValueChanged="IdleDelaySlider_ValueChanged"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,18"/>

                                <!-- Keystroke Display Duration -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Keystroke badge duration"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="How long typed keys stay visible before returning to your name tag"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="12"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Background="{DynamicResource BtnBgBrush}"
                                            CornerRadius="7"
                                            Padding="10,4"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                        <TextBlock x:Name="KeyDurationLabel"
                                                   Text="1.1s"
                                                   Foreground="#60A5FA"
                                                   FontSize="12.5"
                                                   FontWeight="Bold"/>
                                    </Border>
                                    <Slider x:Name="KeyDurationSlider"
                                            Grid.Row="1"
                                            Minimum="0.4"
                                            Maximum="5.0"
                                            TickFrequency="0.1"
                                            IsSnapToTickEnabled="True"
                                            Style="{StaticResource SleekSliderStyle}"
                                            Margin="0,10,0,0"
                                            ValueChanged="KeyDurationSlider_ValueChanged"/>
                                </Grid>

                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,16"/>

                                <!-- Startup Toggle Row -->
                                <Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Launch on Windows startup"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Automatically start Tagsor in the system tray when you sign in"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="12"
                                                   Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <CheckBox x:Name="StartupCheckBox"
                                              HorizontalAlignment="Right"
                                              VerticalAlignment="Center"
                                              Style="{StaticResource ModernToggleSwitch}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- TAB 3: GLOBAL SHORTCUTS -->
                    <StackPanel x:Name="ShortcutsTabView" Visibility="Collapsed">
                        <Grid Margin="2,0,2,10">
                            <TextBlock Text="Click any shortcut box and press your new key combination"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                            <Button Content="Reset defaults"
                                    HorizontalAlignment="Right"
                                    Padding="10,4"
                                    FontSize="11.5"
                                    Style="{StaticResource SubtleButton}"
                                    Click="ResetHotkeys_Click"/>
                        </Grid>

                        <Border Background="{DynamicResource SectionBgBrush}"
                                BorderBrush="{DynamicResource SectionBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16,10">
                            <StackPanel>
                                <Grid Margin="0,6">
                                    <TextBlock Text="Hide keystrokes (Privacy mode)" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBox x:Name="PrivacyHotkeyBox" HorizontalAlignment="Right" Style="{StaticResource HotkeyBoxStyle}" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource DividerBrush}"/>

                                <Grid Margin="0,6">
                                    <TextBlock Text="Spotlight focus dimmer" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBox x:Name="SpotlightHotkeyBox" HorizontalAlignment="Right" Style="{StaticResource HotkeyBoxStyle}" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource DividerBrush}"/>

                                <Grid Margin="0,6">
                                    <TextBlock Text="Screen marker &amp; shape pen" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBox x:Name="MarkerHotkeyBox" HorizontalAlignment="Right" Style="{StaticResource HotkeyBoxStyle}" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource DividerBrush}"/>

                                <Grid Margin="0,6">
                                    <TextBlock Text="Status chip — 👀 Look here" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBox x:Name="Status1HotkeyBox" HorizontalAlignment="Right" Style="{StaticResource HotkeyBoxStyle}" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource DividerBrush}"/>

                                <Grid Margin="0,6">
                                    <TextBlock Text="Status chip — ⏸ Hold on" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBox x:Name="Status2HotkeyBox" HorizontalAlignment="Right" Style="{StaticResource HotkeyBoxStyle}" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                                </Grid>
                                <Border Height="1" Background="{DynamicResource DividerBrush}"/>

                                <Grid Margin="0,6">
                                    <TextBlock Text="Status chip — ✅ Done" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBox x:Name="Status3HotkeyBox" HorizontalAlignment="Right" Style="{StaticResource HotkeyBoxStyle}" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Footer Bar -->
                <Grid Margin="0,22,0,0">
                    <Button Content="Open config folder"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SubtleButton}"
                            Click="OpenFolder_Click"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Margin="0,0,10,0"
                                Style="{StaticResource SubtleButton}"
                                Padding="16,9"
                                Click="CancelButton_Click"/>
                        <Button Content="Save Changes"
                                Style="{StaticResource AccentPrimaryButton}"
                                Click="SaveButton_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
