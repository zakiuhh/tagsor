<Window x:Class="Tagsor.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="560"
        Height="510"
        MinWidth="440"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome ResizeBorderThickness="8"
                            CaptionHeight="0"
                            CornerRadius="16"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootBorder"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.20">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.97" To="1.0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.97" To="1.0" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <SolidColorBrush x:Key="CardBgBrush" Color="#1C1C21"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#2E2E36"/>
        <SolidColorBrush x:Key="SectionBgBrush" Color="#24242B"/>
        <SolidColorBrush x:Key="SectionBorderBrush" Color="#32323C"/>
        <SolidColorBrush x:Key="RowHoverBrush" Color="#2B2B33"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#2E2E37"/>
        <SolidColorBrush x:Key="TabBarBgBrush" Color="#151519"/>
        <SolidColorBrush x:Key="ActiveTabBgBrush" Color="#2B2B34"/>
        <SolidColorBrush x:Key="ActiveTabBorderBrush" Color="#3C3C48"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4F4F6"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8E929F"/>
        <SolidColorBrush x:Key="BtnBgBrush" Color="#2C2C35"/>
        <SolidColorBrush x:Key="BtnHoverBgBrush" Color="#373742"/>
        <SolidColorBrush x:Key="BtnBorderBrush" Color="#3E3E4A"/>
        <SolidColorBrush x:Key="CloseHoverBgBrush" Color="#2E2E37"/>
        <SolidColorBrush x:Key="CloseIconBrush" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="DangerTextBrush" Color="#FB7185"/>
        <SolidColorBrush x:Key="DangerHoverBrush" Color="#3B2026"/>
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#454552"/>
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#636374"/>

        <!-- Custom Sleek Rounded Pill ScrollBar -->
        <Style x:Key="CustomScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbPill"
                                Background="{DynamicResource ScrollThumbBrush}"
                                CornerRadius="3"
                                Margin="1,2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbPill" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbPill" Property="Background" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="6"/>
            <Setter Property="MinWidth" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource CustomScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ClosePill" Background="Transparent" CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ClosePill" Property="Background" Value="{DynamicResource CloseHoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Vector Icon Segmented Tab -->
        <Style x:Key="SegmentedTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="8,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabPill"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="TabIcon"
                                      Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                      Stroke="{TemplateBinding Foreground}"
                                      StrokeThickness="1.75"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"
                                      Width="14"
                                      Height="14"
                                      Stretch="Uniform"
                                      Margin="0,0,7,0"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabPill" Property="Background" Value="{DynamicResource ActiveTabBgBrush}"/>
                                <Setter TargetName="TabPill" Property="BorderBrush" Value="{DynamicResource ActiveTabBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                                <Setter TargetName="TabIcon" Property="Stroke" Value="#60A5FA"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PositionOptionStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Pill"
                                Background="{DynamicResource BtnBgBrush}"
                                BorderBrush="{DynamicResource BtnBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="13,7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="#213147"/>
                                <Setter TargetName="Pill" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter Property="Foreground" Value="#60A5FA"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubtleButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BtnBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BtnHoverBgBrush}"/>
                                <Setter TargetName="Border" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BtnBgBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerMiniButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="Transparent" CornerRadius="7" Padding="8,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource DangerHoverBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentPrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#60A5FA"/>
            <Setter Property="Foreground" Value="#0F1117"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Track"
                                Width="42"
                                Height="22"
                                CornerRadius="11"
                                Background="{DynamicResource BtnBgBrush}"
                                BorderBrush="{DynamicResource BtnBorderBrush}"
                                BorderThickness="1">
                            <Ellipse x:Name="Thumb"
                                     Width="16"
                                     Height="16"
                                     Fill="#E4E4E7"
                                     HorizontalAlignment="Left"
                                     Margin="2,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="ThumbSlide" X="0"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="#60A5FA"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="#0F1117"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbSlide"
                                                             Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbSlide"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Fluid 60+ FPS Slider with Click-to-Point & Hover/Drag Thumb Scale -->
        <Style x:Key="SleekSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" VerticalAlignment="Center">
                            <Border Height="4"
                                    CornerRadius="2"
                                    Background="{DynamicResource BtnBgBrush}"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="#60A5FA"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbCircle"
                                                        Width="16"
                                                        Height="16"
                                                        CornerRadius="8"
                                                        Background="#F4F4F6"
                                                        BorderBrush="#60A5FA"
                                                        BorderThickness="2.5"
                                                        RenderTransformOrigin="0.5,0.5">
                                                    <Border.RenderTransform>
                                                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                    </Border.RenderTransform>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbCircle" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="1.18" ScaleY="1.18"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbCircle" Property="RenderTransform">
                                                            <Setter.Value>
                                                                <ScaleTransform ScaleX="1.25" ScaleY="1.25"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter TargetName="ThumbCircle" Property="Background" Value="#60A5FA"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HotkeyBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource BtnBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BtnBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="138"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#60A5FA"/>
                                <Setter TargetName="BoxBorder" Property="BorderThickness" Value="1.5"/>
                                <Setter TargetName="BoxBorder" Property="Background" Value="#213147"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="OuterMarginGrid" Margin="14">
        <Border x:Name="RootBorder"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="24,20,24,20"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadow" BlurRadius="26" ShadowDepth="6" Opacity="0.52" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Clean Uncluttered Header -->
                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Settings"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <Border Background="{DynamicResource SectionBgBrush}"
                                    BorderBrush="{DynamicResource SectionBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="7,1.5"
                                    Margin="10,1,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="CurrentVersionBadge"
                                           Text="v1.4.0"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Manage mouse profiles, pill appearance, timing, and shortcuts"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource CaptionButtonStyle}"
                                ToolTip="Maximize / Restore"
                                Click="MaximizeRestore_Click"
                                Margin="0,0,4,0">
                            <Viewbox Width="11" Height="11">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="MaximizeGlyph"
                                          Data="M 5,5 H 19 V 19 H 5 Z"
                                          Stroke="{DynamicResource CloseIconBrush}"
                                          StrokeThickness="2.1"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button Style="{StaticResource CaptionButtonStyle}"
                                ToolTip="Close"
                                Click="CancelButton_Click">
                            <Viewbox Width="11" Height="11">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 6,6 L 18,18 M 18,6 L 6,18"
                                          Stroke="{DynamicResource CloseIconBrush}"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- GitHub Release Update Banner -->
                <Border x:Name="UpdateBanner"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Background="#1C2D42"
                        BorderBrush="#3B82F6"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14,10"
                        Margin="0,0,0,14">
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="UpdateBannerTitle"
                                       Text="Update available"
                                       Foreground="#93C5FD"
                                       FontSize="12.5"
                                       FontWeight="SemiBold"/>
                            <TextBlock x:Name="UpdateBannerSubtitle"
                                       Text="A newer version of Tagsor is ready."
                                       Foreground="#CBD5E1"
                                       FontSize="11.5"
                                       Margin="0,1,0,0"/>
                        </StackPanel>

                        <Button x:Name="InstallUpdateBtn"
                                Content="Install &amp; Restart"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Style="{StaticResource AccentPrimaryButton}"
                                Padding="13,6"
                                FontSize="11.5"
                                Click="InstallUpdate_Click"/>
                    </Grid>
                </Border>

                <!-- Native Vector-Icon Segmented Navigation -->
                <Border Grid.Row="2"
                        Background="{DynamicResource TabBarBgBrush}"
                        BorderBrush="{DynamicResource SectionBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="4"
                        Margin="0,0,0,16">
                    <UniformGrid Columns="4">
                        <RadioButton x:Name="TabProfilesBtn"
                                     Content="Profiles"
                                     Tag="M 7,2 H 17 A 4,4 0 0 1 21,6 V 16 A 6,6 0 0 1 15,22 H 9 A 6,6 0 0 1 3,16 V 6 A 4,4 0 0 1 7,2 Z M 12,6 V 10"
                                     IsChecked="True"
                                     Style="{StaticResource SegmentedTabStyle}"
                                     Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabAppearanceBtn"
                                     Content="Appearance"
                                     Tag="M 12,3 A 9,9 0 1 0 21,12 C 21,10.5 19.8,9.5 18.5,9.5 H 16 A 2,2 0 0 1 14,7.5 V 5 C 14,3.8 13.1,3 12,3 Z"
                                     Style="{StaticResource SegmentedTabStyle}"
                                     Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabBehaviorBtn"
                                     Content="Timing"
                                     Tag="M 12,3 A 9,9 0 1 0 21,12 A 9,9 0 0 0 12,3 Z M 12,7 V 12 L 15.5,14"
                                     Style="{StaticResource SegmentedTabStyle}"
                                     Checked="Tab_Checked"/>
                        <RadioButton x:Name="TabShortcutsBtn"
                                     Content="Shortcuts"
                                     Tag="M 3,6 H 21 A 2,2 0 0 1 23,8 V 16 A 2,2 0 0 1 21,18 H 3 A 2,2 0 0 1 1,16 V 8 A 2,2 0 0 1 3,6 Z M 6,10 H 6.01 M 10,10 H 10.01 M 14,10 H 14.01 M 18,10 H 18.01 M 7,14 H 17"
                                     Style="{StaticResource SegmentedTabStyle}"
                                     Checked="Tab_Checked"/>
                    </UniformGrid>
                </Border>

                <!-- Scrollable Content Area -->
                <ScrollViewer Grid.Row="3"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0">
                    <Grid x:Name="TabContentContainer" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="TabSlideTransform" Y="0"/>
                        </Grid.RenderTransform>

                        <!-- TAB 1: MICE & PROFILES -->
                        <StackPanel x:Name="ProfilesTabView" Visibility="Visible">
                            <Grid Margin="2,0,2,8">
                                <TextBlock Text="SAVED MICE"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <TextBlock x:Name="MouseCountLabel"
                                           Text="0 devices"
                                           HorizontalAlignment="Right"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="11"
                                           VerticalAlignment="Center"/>
                            </Grid>

                            <Border Background="{DynamicResource SectionBgBrush}"
                                    BorderBrush="{DynamicResource SectionBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="10,6">
                                <StackPanel>
                                    <StackPanel x:Name="MiceListPanel"/>
                                    <StackPanel x:Name="EmptyMiceState" Margin="0,28,0,28" Visibility="Collapsed">
                                        <TextBlock Text="No saved mice yet"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Move or click any mouse to automatically detect and name it."
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="12"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 2: APPEARANCE -->
                        <StackPanel x:Name="AppearanceTabView" Visibility="Collapsed">
                            <Grid Margin="2,0,2,8">
                                <TextBlock Text="CURSOR PILL STYLING"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <Button Content="Reset defaults"
                                        HorizontalAlignment="Right"
                                        Padding="8,3"
                                        FontSize="11"
                                        Style="{StaticResource GhostLinkButton}"
                                        Click="ResetAppearance_Click"/>
                            </Grid>

                            <Border Background="{DynamicResource SectionBgBrush}"
                                    BorderBrush="{DynamicResource SectionBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,14">
                                <StackPanel>
                                    <!-- Pill Scale -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Pill scale" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Resize the floating cursor tag for 1080p or 4K monitors" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Background="{DynamicResource BtnBgBrush}" CornerRadius="6" Padding="9,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock x:Name="PillScaleLabel" Text="1.00x" Foreground="#60A5FA" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                        <Slider x:Name="PillScaleSlider"
                                                Grid.Row="1"
                                                Minimum="0.8"
                                                Maximum="1.4"
                                                Style="{StaticResource SleekSliderStyle}"
                                                Margin="0,6,0,0"
                                                ValueChanged="AppearanceSlider_ValueChanged"/>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14"/>

                                    <!-- Corner Radius -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Corner radius" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Blend between a sharp badge (4px) and a full capsule pill (22px)" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Background="{DynamicResource BtnBgBrush}" CornerRadius="6" Padding="9,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock x:Name="PillRadiusLabel" Text="15 px" Foreground="#60A5FA" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                        <Slider x:Name="PillRadiusSlider"
                                                Grid.Row="1"
                                                Minimum="4"
                                                Maximum="22"
                                                Style="{StaticResource SleekSliderStyle}"
                                                Margin="0,6,0,0"
                                                ValueChanged="AppearanceSlider_ValueChanged"/>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14"/>

                                    <!-- Opacity -->
                                    <Grid Margin="0,0,0,14">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Pill opacity" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Keep underlying UI readable during dense screen shares" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Background="{DynamicResource BtnBgBrush}" CornerRadius="6" Padding="9,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock x:Name="PillOpacityLabel" Text="100%" Foreground="#60A5FA" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                        <Slider x:Name="PillOpacitySlider"
                                                Grid.Row="1"
                                                Minimum="0.4"
                                                Maximum="1.0"
                                                Style="{StaticResource SleekSliderStyle}"
                                                Margin="0,6,0,0"
                                                ValueChanged="AppearanceSlider_ValueChanged"/>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14"/>

                                    <!-- Position Offset -->
                                    <StackPanel>
                                        <TextBlock Text="Position offset" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="Choose where the tag sits around your pointer" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,2,0,9"/>

                                        <WrapPanel Orientation="Horizontal">
                                            <RadioButton x:Name="PosBottomRightBtn"
                                                         Content="Bottom-right"
                                                         GroupName="PosOffsetGroup"
                                                         Style="{StaticResource PositionOptionStyle}"
                                                         Checked="PositionOption_Checked"/>
                                            <RadioButton x:Name="PosTopRightBtn"
                                                         Content="Top-right"
                                                         GroupName="PosOffsetGroup"
                                                         Style="{StaticResource PositionOptionStyle}"
                                                         Checked="PositionOption_Checked"/>
                                            <RadioButton x:Name="PosCenteredBelowBtn"
                                                         Content="Centered below"
                                                         GroupName="PosOffsetGroup"
                                                         Style="{StaticResource PositionOptionStyle}"
                                                         Checked="PositionOption_Checked"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 3: TIMING & BEHAVIOR -->
                        <StackPanel x:Name="BehaviorTabView" Visibility="Collapsed">
                            <TextBlock Text="TIMING &amp; SYSTEM"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Margin="2,0,0,8"/>

                            <Border Background="{DynamicResource SectionBgBrush}"
                                    BorderBrush="{DynamicResource SectionBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Idle fade-out delay" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Seconds after stopping movement before the tag fades out" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Background="{DynamicResource BtnBgBrush}" CornerRadius="6" Padding="9,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock x:Name="IdleDelayLabel" Text="2.5s" Foreground="#60A5FA" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                        <Slider x:Name="IdleDelaySlider"
                                                Grid.Row="1"
                                                Minimum="0.5"
                                                Maximum="15.0"
                                                Style="{StaticResource SleekSliderStyle}"
                                                Margin="0,8,0,0"
                                                ValueChanged="IdleDelaySlider_ValueChanged"/>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,16"/>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Keystroke badge duration" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="How long typed keys stay visible before reverting to your name" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Background="{DynamicResource BtnBgBrush}" CornerRadius="6" Padding="9,3" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock x:Name="KeyDurationLabel" Text="1.1s" Foreground="#60A5FA" FontSize="12" FontWeight="Bold"/>
                                        </Border>
                                        <Slider x:Name="KeyDurationSlider"
                                                Grid.Row="1"
                                                Minimum="0.4"
                                                Maximum="5.0"
                                                Style="{StaticResource SleekSliderStyle}"
                                                Margin="0,8,0,0"
                                                ValueChanged="KeyDurationSlider_ValueChanged"/>
                                    </Grid>

                                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,14"/>

                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Launch on Windows startup" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Start Tagsor quietly in the system tray when you sign in" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11.5" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <CheckBox x:Name="StartupCheckBox"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  Style="{StaticResource ModernToggleSwitch}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- TAB 4: GLOBAL SHORTCUTS -->
                        <StackPanel x:Name="ShortcutsTabView" Visibility="Collapsed">
                            <Grid Margin="2,0,2,8">
                                <TextBlock Text="CLICK A PILL TO REBIND"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="10.5"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <Button Content="Reset defaults" HorizontalAlignment="Right" Padding="8,3" FontSize="11" Style="{StaticResource GhostLinkButton}" Click="ResetHotkeys_Click"/>
                            </Grid>

                            <Border Background="{DynamicResource SectionBgBrush}"
                                    BorderBrush="{DynamicResource SectionBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16,8">
                                <StackPanel>
                                    <Grid Margin="0,6">
                                        <TextBlock Text="Hide keystrokes (Privacy mode)" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                        <TextBox x:Name="PrivacyHotkeyBox" HorizontalAlignment="Right" Style="{StaticResource HotkeyBoxStyle}" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}"/>

                                    <Grid Margin="0,6">
                                        <TextBlock Text="Spotlight focus dimmer" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                        <TextBox x:Name="SpotlightHotkeyBox" HorizontalAlignment="Right" Style="{StaticResource HotkeyBoxStyle}" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}"/>

                                    <Grid Margin="0,6">
                                        <TextBlock Text="Screen marker &amp; shape pen" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                        <TextBox x:Name="MarkerHotkeyBox" HorizontalAlignment="Right" Style="{StaticResource HotkeyBoxStyle}" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}"/>

                                    <Grid Margin="0,6">
                                        <TextBlock Text="Status chip — Look here" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                        <TextBox x:Name="Status1HotkeyBox" HorizontalAlignment="Right" Style="{StaticResource HotkeyBoxStyle}" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}"/>

                                    <Grid Margin="0,6">
                                        <TextBlock Text="Status chip — Hold on" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                        <TextBox x:Name="Status2HotkeyBox" HorizontalAlignment="Right" Style="{StaticResource HotkeyBoxStyle}" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                                    </Grid>
                                    <Border Height="1" Background="{DynamicResource DividerBrush}"/>

                                    <Grid Margin="0,6">
                                        <TextBlock Text="Status chip — Done" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="12.5" VerticalAlignment="Center"/>
                                        <TextBox x:Name="Status3HotkeyBox" HorizontalAlignment="Right" Style="{StaticResource HotkeyBoxStyle}" GotKeyboardFocus="HotkeyBox_GotFocus" LostKeyboardFocus="HotkeyBox_LostFocus" PreviewKeyDown="HotkeyBox_PreviewKeyDown"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>

                <!-- Clean Footer -->
                <Grid Grid.Row="4" Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button x:Name="CheckUpdateBtn"
                                Content="Check for updates"
                                Style="{StaticResource GhostLinkButton}"
                                Margin="0,0,4,0"
                                Click="CheckUpdate_Click"/>
                        <TextBlock Text="·" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="2,0"/>
                        <Button Content="Config folder"
                                Style="{StaticResource GhostLinkButton}"
                                Margin="4,0,0,0"
                                Click="OpenFolder_Click"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancel"
                                Margin="0,0,8,0"
                                Style="{StaticResource SubtleButton}"
                                Padding="15,8"
                                Click="CancelButton_Click"/>
                        <Button Content="Save Changes"
                                Style="{StaticResource AccentPrimaryButton}"
                                Click="SaveButton_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
