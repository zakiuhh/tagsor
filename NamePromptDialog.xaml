<Window x:Class="Tagsor.NamePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootBorder"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.22">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.93" To="1.0" Duration="0:0:0.26">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.93" To="1.0" Duration="0:0:0.26">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.35"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <SolidColorBrush x:Key="CardBgBrush" Color="#28282D"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#42424A"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F3F3F5"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A1A1AA"/>
        <SolidColorBrush x:Key="InputBgBrush" Color="#202024"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#3C3C44"/>
        <SolidColorBrush x:Key="BtnBgBrush" Color="#36363E"/>
        <SolidColorBrush x:Key="BtnHoverBgBrush" Color="#44444E"/>
        <SolidColorBrush x:Key="BtnBorderBrush" Color="#4A4A54"/>
        <SolidColorBrush x:Key="CloseHoverBgBrush" Color="#3A3A42"/>
        <SolidColorBrush x:Key="CloseIconBrush" Color="#9CA3AF"/>

        <Style x:Key="RoundedCloseButton" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ClosePill"
                                Background="Transparent"
                                CornerRadius="8">
                            <Viewbox Width="13" Height="13">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="XPath"
                                          Data="M 6,6 L 18,18 M 18,6 L 6,18"
                                          Stroke="{DynamicResource CloseIconBrush}"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ClosePill" Property="Background" Value="{DynamicResource CloseHoverBgBrush}"/>
                                <Setter TargetName="XPath" Property="Stroke" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ClosePill" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ColorSwatchStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="26" Height="26">
                            <Ellipse x:Name="OuterRing"
                                     Stroke="{TemplateBinding Foreground}"
                                     StrokeThickness="2"
                                     Opacity="0"/>
                            <Ellipse x:Name="InnerDot"
                                     Width="18" Height="18"
                                     Fill="{TemplateBinding Foreground}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OuterRing" Property="Opacity" Value="1"/>
                                <Setter TargetName="InnerDot" Property="Width" Value="14"/>
                                <Setter TargetName="InnerDot" Property="Height" Value="14"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterRing" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="CaretBrush" Value="#60A5FA"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,8"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryPillButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BtnBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource BtnHoverBgBrush}"/>
                                <Setter TargetName="BtnBorder" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Border x:Name="RootBorder"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="20"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadow" BlurRadius="22" ShadowDepth="6" Opacity="0.55" Color="#000000"/>
            </Border.Effect>

            <StackPanel>
                <Grid Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="M 12,2 A 6,6 0 0 1 18,8 V 16 A 6,6 0 0 1 6,16 V 8 A 6,6 0 0 1 12,2 Z M 12,6 V 10"
                                      Stroke="#60A5FA"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock x:Name="HeaderLabel"
                                   Text="New mouse detected"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource RoundedCloseButton}"
                            Click="CloseButton_Click"/>
                </Grid>

                <TextBlock Text="Display name"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="NameInput"
                         Style="{StaticResource ModernTextBox}"
                         MaxLength="24"/>

                <TextBlock Text="Accent color"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12"
                           Margin="0,14,0,8"/>

                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ColorBlue" Style="{StaticResource ColorSwatchStyle}" Foreground="#60A5FA" IsChecked="True"/>
                    <RadioButton x:Name="ColorGreen" Style="{StaticResource ColorSwatchStyle}" Foreground="#4ADE80"/>
                    <RadioButton x:Name="ColorAmber" Style="{StaticResource ColorSwatchStyle}" Foreground="#FBBF24"/>
                    <RadioButton x:Name="ColorPurple" Style="{StaticResource ColorSwatchStyle}" Foreground="#C084FC"/>
                    <RadioButton x:Name="ColorRose" Style="{StaticResource ColorSwatchStyle}" Foreground="#FB7185"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Content="Save"
                            Style="{StaticResource PrimaryPillButton}"
                            IsDefault="True"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
