<Window x:Class="Tagsor.NamePromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Width="460"
        Height="395"
        MinWidth="340"
        MinHeight="310"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.BitmapScalingMode="HighQuality"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome ResizeBorderThickness="8"
                            CaptionHeight="0"
                            CornerRadius="16"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="RootBorder"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.20">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.96" To="1.0" Duration="0:0:0.24">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.96" To="1.0" Duration="0:0:0.24">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>

    <Window.Resources>
        <SolidColorBrush x:Key="CardBgBrush" Color="#1F1F24"/>
        <SolidColorBrush x:Key="CardBorderBrush" Color="#35353E"/>
        <SolidColorBrush x:Key="SectionBgBrush" Color="#27272E"/>
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#F4F4F6"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="InputBgBrush" Color="#18181C"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#3C3C46"/>
        <SolidColorBrush x:Key="BtnBgBrush" Color="#32323B"/>
        <SolidColorBrush x:Key="BtnHoverBgBrush" Color="#3E3E49"/>
        <SolidColorBrush x:Key="BtnBorderBrush" Color="#444450"/>
        <SolidColorBrush x:Key="CaptionHoverBrush" Color="#32323B"/>
        <SolidColorBrush x:Key="CaptionIconBrush" Color="#9CA3AF"/>
        <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A4A56"/>
        <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#686878"/>

        <!-- Custom Sleek Rounded Pill ScrollBar -->
        <Style x:Key="CustomScrollBarThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbPill"
                                Background="{DynamicResource ScrollThumbBrush}"
                                CornerRadius="3"
                                Margin="1,2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbPill" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbPill" Property="Background" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Width" Value="7"/>
            <Setter Property="MinWidth" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource CustomScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="Height" Value="7"/>
                    <Setter Property="MinHeight" Value="7"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" IsTabStop="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource CustomScrollBarThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" IsTabStop="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Window Caption Button -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource CaptionHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Fixed-Height Input Box -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="CaretBrush" Value="#60A5FA"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="13,0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="BoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalAlignment="Center"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="BoxBorder" Property="BorderBrush" Value="#60A5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SubtleButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BtnBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BtnBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BtnHoverBgBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryAccentButton" TargetType="Button">
            <Setter Property="Background" Value="#60A5FA"/>
            <Setter Property="Foreground" Value="#0F1117"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="18,9"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Opacity" Value="0.9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="OuterMarginGrid" Margin="14">
        <Border x:Name="RootBorder"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="24,20,24,22"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="CardShadow" BlurRadius="24" ShadowDepth="6" Opacity="0.5" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Responsive Draggable Header -->
                <Grid Grid.Row="0"
                      Background="Transparent"
                      MouseLeftButtonDown="Header_MouseLeftButtonDown"
                      Margin="0,0,0,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock x:Name="TitleText"
                                   Text="Edit mouse profile"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   FontSize="16.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="SubtitleText"
                                   Text="Give this mouse a name and accent color."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource CaptionButtonStyle}"
                                ToolTip="Maximize / Restore"
                                Click="MaximizeRestore_Click"
                                Margin="0,0,4,0">
                            <Viewbox Width="12" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="MaximizeGlyph"
                                          Data="M 5,5 H 19 V 19 H 5 Z"
                                          Stroke="{DynamicResource CaptionIconBrush}"
                                          StrokeThickness="2.1"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Button Style="{StaticResource CaptionButtonStyle}"
                                ToolTip="Close"
                                Click="CancelButton_Click">
                            <Viewbox Width="12" Height="12">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M 6,6 L 18,18 M 18,6 L 6,18"
                                          Stroke="{DynamicResource CaptionIconBrush}"
                                          StrokeThickness="2.2"
                                          StrokeStartLineCap="Round"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Scrollable Fluid Body with Custom Pill ScrollBar -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Stretch">
                        <!-- Profile Name Input -->
                        <TextBlock Text="PROFILE NAME"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   FontSize="10.5"
                                   FontWeight="Bold"
                                   Margin="2,0,0,7"/>

                        <TextBox x:Name="NameInputBox"
                                 Style="{StaticResource RoundedTextBox}"
                                 Margin="0,0,0,18"
                                 TextChanged="NameInputBox_TextChanged"/>

                        <!-- Accent Color Picker Section -->
                        <Grid Margin="2,0,2,8">
                            <TextBlock Text="ACCENT COLOR"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="HexValidationHint"
                                       Text="Valid hex"
                                       HorizontalAlignment="Right"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11.5"/>
                        </Grid>

                        <Border Background="{DynamicResource SectionBgBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14,12">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel x:Name="PresetSwatchesPanel"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Center"
                                            Margin="0,3,14,3"/>

                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,3,0,3">
                                    <Border x:Name="LivePreviewSwatch"
                                            Width="32"
                                            Height="32"
                                            CornerRadius="8"
                                            Background="#60A5FA"
                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                            BorderThickness="1.2"
                                            Margin="0,0,8,0"
                                            ToolTip="Live accent color preview"/>

                                    <TextBox x:Name="HexInputBox"
                                             Width="104"
                                             Height="34"
                                             MaxLength="7"
                                             FontFamily="Consolas"
                                             FontSize="12.5"
                                             FontWeight="SemiBold"
                                             Padding="10,0"
                                             Style="{StaticResource RoundedTextBox}"
                                             Text="#60A5FA"
                                             ToolTip="Enter custom #RRGGBB hex code"
                                             TextChanged="HexInputBox_TextChanged"/>
                                </StackPanel>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Bar -->
                <Grid Grid.Row="2" Margin="0,18,0,0">
                    <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="Cancel"
                                Margin="0,0,8,0"
                                Style="{StaticResource SubtleButton}"
                                Click="CancelButton_Click"/>
                        <Button x:Name="SaveBtn"
                                Content="Save Profile"
                                Style="{StaticResource PrimaryAccentButton}"
                                Click="SaveButton_Click"/>
                    </WrapPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
