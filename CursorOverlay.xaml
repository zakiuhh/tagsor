<Window x:Class="Tagsor.CursorOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="False"
        SizeToContent="WidthAndHeight"
        MinWidth="0"
        MinHeight="0"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid Margin="18">
        <!-- Expanding Click Ripple Ring -->
        <Ellipse x:Name="ClickRippleRing"
                 Width="26"
                 Height="26"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Top"
                 Margin="-9,-9,0,0"
                 Stroke="#60A5FA"
                 StrokeThickness="2"
                 Opacity="0"
                 RenderTransformOrigin="0.5,0.5">
            <Ellipse.RenderTransform>
                <ScaleTransform x:Name="RippleScale" ScaleX="0.3" ScaleY="0.3" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- Main Floating Pill -->
        <Border x:Name="PillBorder"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="#2B2B30"
                BorderBrush="#42424A"
                BorderThickness="1.2"
                CornerRadius="8"
                Padding="10,4"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1" />
                    <RotateTransform x:Name="PillRotate" Angle="0" />
                    <TranslateTransform x:Name="PillTranslate" X="0" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect x:Name="PillShadow" BlurRadius="8" ShadowDepth="2" Opacity="0.45" Color="#000000"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid>
                    <TextBlock x:Name="UserNameLabel"
                               Text="Zaki"
                               Foreground="#EFEFEF"
                               FontFamily="Segoe UI"
                               FontSize="12.5"
                               FontWeight="Medium"
                               TextWrapping="NoWrap" />

                    <StackPanel x:Name="KeysPanel"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />
                </Grid>

                <!-- Drag / Button Hold Badge (LMB / RMB / MMB) -->
                <Border x:Name="HoldBadge"
                        Visibility="Collapsed"
                        Margin="7,0,0,0"
                        Padding="5,1"
                        CornerRadius="4"
                        Background="#60A5FA">
                    <TextBlock x:Name="HoldBadgeText"
                               Text="LMB"
                               Foreground="#111115"
                               FontFamily="Segoe UI"
                               FontSize="10"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
